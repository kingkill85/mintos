# RG353V drivers missing from Debian's arm64 config
CONFIG_DRM_PANEL_NEWVISION_NV3051D=m
CONFIG_JOYSTICK_ADC=m
CONFIG_INPUT_PWM_VIBRA=m
CONFIG_INPUT_JOYSTICK=y
# no Debian signing infrastructure
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_MODULE_SIG=n
CONFIG_MODULE_SIG_ALL=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_DWARF5=n
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=n
CONFIG_LOCALVERSION="-rg353v"
CONFIG_CRYPTO_AEGIS128_SIMD=n
