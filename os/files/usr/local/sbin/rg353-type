#!/usr/bin/python3
"""Type keys through a temporary uinput keyboard (testing): rg353-type KEY_1 W KEY_ENTER
("W" waits 1.5 s)."""
import sys, time, evdev
from evdev import ecodes as e, UInput
keys = [getattr(e, k) for k in sys.argv[1:] if k != "W"]
ui = UInput({e.EV_KEY: sorted(set(keys))}, name="rg353-type keyboard")
time.sleep(2)
for k in sys.argv[1:]:
    if k == "W":
        time.sleep(1.5); continue
    c = getattr(e, k)
    ui.write(e.EV_KEY, c, 1); ui.syn(); time.sleep(0.15); ui.write(e.EV_KEY, c, 0); ui.syn(); time.sleep(0.5)
time.sleep(1); ui.close()
