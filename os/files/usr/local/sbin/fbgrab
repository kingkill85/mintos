#!/usr/bin/python3
"""Screenshot of what the panel shows: fbgrab [out.png] (root, needs debugfs).
Reads the fb on the primary plane from /sys/kernel/debug/dri/display-subsystem/state."""
import fcntl, mmap, os, struct, sys, zlib
def IOWR(nr, size): return (3 << 30) | (size << 16) | (ord('d') << 8) | nr
import glob, re
out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/screen.png'
if not os.path.exists('/sys/kernel/debug/dri'):
    os.system('mount -t debugfs none /sys/kernel/debug')
st = open('/sys/kernel/debug/dri/display-subsystem/state').read()
fb_id = int(re.search(r'Esmart0-win0\n\tcrtc=\S+\n\tfb=(\d+)', st).group(1))
for card in sorted(glob.glob('/dev/dri/card*')):
    if os.path.basename(os.path.realpath('/sys/class/drm/' + os.path.basename(card) + '/device/driver')) == 'rockchip-drm':
        break
fd = os.open(card, os.O_RDWR)
buf = bytearray(104)
struct.pack_into('I', buf, 0, fb_id)
fcntl.ioctl(fd, IOWR(0xCE, 104), buf)
_, w, h, fmt, flags = struct.unpack_from('5I', buf, 0)
handle = struct.unpack_from('I', buf, 20)[0]
pitch = struct.unpack_from('I', buf, 36)[0]
ph = bytearray(struct.pack('IIi', handle, 0x80000 | 2, -1))  # DRM_CLOEXEC | DRM_RDWR
fcntl.ioctl(fd, IOWR(0x2d, 12), ph)
dfd = struct.unpack_from('IIi', ph)[2]
m = mmap.mmap(dfd, pitch * h, mmap.MAP_SHARED, mmap.PROT_READ)
raw = b''
for y in range(h):
    row = m[y * pitch:y * pitch + w * 4]
    rgb = bytearray(w * 3)
    rgb[0::3] = row[2::4]; rgb[1::3] = row[1::4]; rgb[2::3] = row[0::4]
    raw += b'\0' + bytes(rgb)
def chunk(t, d): return struct.pack('>I', len(d)) + t + d + struct.pack('>I', zlib.crc32(t + d))
png = b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0)) + chunk(b'IDAT', zlib.compress(raw)) + chunk(b'IEND', b'')
open(out, 'wb').write(png)
print(w, h, hex(fmt), 'nonzero bytes:', sum(1 for b in m[:pitch*h:97] if b))
