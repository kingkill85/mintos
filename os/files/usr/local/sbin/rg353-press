#!/usr/bin/python3
"""Inject a button chord into "RG353V Gamepad" (testing): rg353-press BTN_MODE BTN_START"""
import sys, time, evdev
from evdev import ecodes as e
dev = next(evdev.InputDevice(p) for p in evdev.list_devices() if evdev.InputDevice(p).name == "RG353V Gamepad")
codes = [getattr(e, n) for n in sys.argv[1:]]
for c in codes:
    dev.write(e.EV_KEY, c, 1); dev.write(e.EV_SYN, 0, 0); time.sleep(0.05)
time.sleep(0.2)
for c in reversed(codes):
    dev.write(e.EV_KEY, c, 0); dev.write(e.EV_SYN, 0, 0); time.sleep(0.05)
