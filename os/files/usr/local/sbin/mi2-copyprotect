#!/usr/bin/python3
"""Answer Monkey Island 2's Mix'n'Mojo copy protection automatically.

ScummVM keeps the screen (the difficulty choice follows it) but accepts any numbers.
Started in the background by launch.sh for the "monkey2" target: watches the panel for
the purple protection screen (132,0,181), then presses Return and types 1234 + Return
through a temporary uinput keyboard (RetroArch hands keyboard input to the core).
"""
import fcntl, glob, mmap, os, re, struct, time
import evdev
from evdev import ecodes as e

PURPLE = (132, 0, 181)


def IOWR(nr, size): return (3 << 30) | (size << 16) | (ord('d') << 8) | nr


def pixels(points):
    """RGB of the given points on the scanned-out framebuffer, or None."""
    try:
        st = open('/sys/kernel/debug/dri/display-subsystem/state').read()
        fb_id = int(re.search(r'Esmart0-win0\n\tcrtc=\S+\n\tfb=(\d+)', st).group(1))
        card = next(c for c in sorted(glob.glob('/dev/dri/card*')) if os.path.basename(os.path.realpath(
            '/sys/class/drm/' + os.path.basename(c) + '/device/driver')) == 'rockchip-drm')
        fd = os.open(card, os.O_RDWR)
        buf = bytearray(104); struct.pack_into('I', buf, 0, fb_id)
        fcntl.ioctl(fd, IOWR(0xCE, 104), buf)
        h = struct.unpack_from('5I', buf, 0)[2]
        handle, pitch = struct.unpack_from('I', buf, 20)[0], struct.unpack_from('I', buf, 36)[0]
        ph = bytearray(struct.pack('IIi', handle, 0x80000 | 2, -1))
        fcntl.ioctl(fd, IOWR(0x2d, 12), ph)
        dfd = struct.unpack_from('IIi', ph)[2]
        m = mmap.mmap(dfd, pitch * h, mmap.MAP_SHARED, mmap.PROT_READ)
        out = [tuple(m[y * pitch + x * 4 + i] for i in (2, 1, 0)) for x, y in points]
        m.close(); os.close(dfd); os.close(fd)
        return out
    except Exception:
        return None


def purple():
    p = pixels([(20, 100), (620, 400)])
    return p is not None and all(abs(a - b) < 12 for c in p for a, b in zip(c, PURPLE))


def press(ui, *keys):
    for k in keys:
        ui.write(e.EV_KEY, k, 1); ui.syn(); time.sleep(0.15)
        ui.write(e.EV_KEY, k, 0); ui.syn(); time.sleep(0.4)


if not os.path.exists('/sys/kernel/debug/dri'):
    os.system('mount -t debugfs none /sys/kernel/debug')
ui = evdev.UInput({e.EV_KEY: [e.KEY_1, e.KEY_2, e.KEY_3, e.KEY_4, e.KEY_ENTER]}, name="mi2-copyprotect")
end = time.time() + 90
while time.time() < end and not purple():
    time.sleep(0.5)
if time.time() < end:
    time.sleep(1); press(ui, e.KEY_ENTER)            # "Drücke Return ..."
    time.sleep(3); press(ui, e.KEY_1, e.KEY_2, e.KEY_3, e.KEY_4)
    time.sleep(1); press(ui, e.KEY_ENTER)
time.sleep(1); ui.close()
