#!/usr/bin/python3
"""Power key like Garlic OS: switching off during a game saves it and resumes on boot.

Short press of the power key (rk805 pwrkey, KEY_POWER):
- a game running (rgarch or RetroArch): remember the game in /storage/.config/rglauncher/resume, stop the
  launcher service (RetroArch gets SIGTERM and writes its auto save state on exit,
  savestate_auto_save), then power off. rglauncher starts that game again on boot with
  RESUME=1, which loads the auto state.
- otherwise: power off.
logind's own power key handling is switched off (logind.conf.d/rg353v.conf).
"""
import os
import shutil
import subprocess
import evdev
from evdev import ecodes as e

CURRENT = "/run/rglauncher-current"
RESUME = "/storage/.config/rglauncher/resume"


def running(name):
    return subprocess.run(["pgrep", "-x", name], capture_output=True).returncode == 0


def power_off():
    if (running("rgarch") or running("retroarch")) and os.path.exists(CURRENT):
        shutil.copyfile(CURRENT, RESUME)
        print("saving", open(CURRENT).read().strip(), flush=True)
    subprocess.run(["systemctl", "stop", "rglauncher"])  # SIGTERM to the game, waits for it
    os.sync()
    subprocess.run(["systemctl", "poweroff"])


dev = next(evdev.InputDevice(p) for p in evdev.list_devices() if evdev.InputDevice(p).name == "rk805 pwrkey")
dev.grab()
for ev in dev.read_loop():
    if ev.type == e.EV_KEY and ev.code == e.KEY_POWER and ev.value == 1:
        power_off()
        break
