#!/usr/bin/python3
"""Bluetooth for the MintOS settings, through bluetoothctl.
  mintos-bt status              powered=0|1
  mintos-bt list [--scan]       "mac<TAB>name<TAB>audio|input|other<TAB>paired<TAB>connected" per device
                                (connected and paired first; devices without a name only when paired)
  mintos-bt connect <mac>       pair (no PIN, "just works") + trust + connect; exit 0 when connected
  mintos-bt disconnect <mac>
  mintos-bt forget <mac>
  mintos-bt power on|off
  mintos-bt boot                apply settings.cfg "bt = off" at start-up
Discovery runs inside bluetoothctl: BlueZ stops a scan when the client that started it leaves."""
import re, subprocess, sys

SETTINGS = "/storage/.config/mintos/settings.cfg"
AUDIO_UUIDS = ("0000110b", "0000110a", "00001108", "0000111e")   # A2DP sink/source, headset, handsfree
INPUT_UUIDS = ("00001124", "00001812")                           # HID, HID over GATT


def ctl(*args, timeout=None):
    cmd = ["bluetoothctl"] + (["--timeout", str(timeout)] if timeout else []) + list(args)
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=(timeout or 10) + 15).stdout
    except subprocess.TimeoutExpired:
        return ""


def is_mac(s):
    return re.fullmatch(r"[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}", s or "") is not None


def parse_devices(out):
    """"Device <mac> <name>" lines -> {mac: name}"""
    devs = {}
    for line in out.splitlines():
        m = re.match(r"Device ([0-9A-F:]{17}) (.*)$", line)
        if m and not m.group(2).startswith("("):
            devs[m.group(1)] = m.group(2)
    return devs


def has_name(mac, name):
    return name != mac.replace(":", "-") and name != mac


def parse_info(out):
    info, uuids = {}, []
    for line in out.splitlines():
        m = re.match(r"\t(\w+): (.*)$", line)
        if not m:
            continue
        if m.group(1) == "UUID":
            uuids.append(m.group(2))
        else:
            info.setdefault(m.group(1), m.group(2))
    if uuids:
        info["UUID"] = " ".join(uuids)
    return info


def kind(info):
    icon, uuid = info.get("Icon", ""), info.get("UUID", "").lower()
    if icon.startswith("audio") or any(u in uuid for u in AUDIO_UUIDS):
        return "audio"
    if icon.startswith("input") or any(u in uuid for u in INPUT_UUIDS):
        return "input"
    return "other"


def ok(out, what):
    return {"pair": "Pairing successful", "connect": "Connection successful"}[what] in out \
        or (what == "pair" and "AlreadyExists" in out)


def cmd_list(scan):
    if scan:
        ctl("scan", "on", timeout=8)
    devs = parse_devices(ctl("devices"))
    paired = set(parse_devices(ctl("devices", "Paired")))
    connected = set(parse_devices(ctl("devices", "Connected")))
    rows = []
    for mac, name in devs.items():
        if not has_name(mac, name) and mac not in paired:
            continue
        rows.append((mac not in connected, mac not in paired, name.lower(), mac, name,
                     kind(parse_info(ctl("info", mac)))))
    for r in sorted(rows):
        print("\t".join([r[3], r[4].replace("\t", " "), r[5], str(int(not r[1])), str(int(not r[0]))]))
    return 0


def cmd_connect(mac):
    info = parse_info(ctl("info", mac))
    if info.get("Paired") != "yes":
        ctl("pairable", "on")
        out = ctl("--agent", "NoInputNoOutput", "pair", mac, timeout=25)
        if not ok(out, "pair"):
            print("Koppeln fehlgeschlagen"); return 1
    ctl("trust", mac)
    if not ok(ctl("connect", mac, timeout=15), "connect"):
        print("Verbindung fehlgeschlagen"); return 1
    return 0


def setting_off():
    try:
        return any(re.match(r"\s*bt\s*=\s*off", l) for l in open(SETTINGS))
    except OSError:
        return False


def main(argv):
    if argv[:1] == ["status"]:
        print("powered=%d" % ("Powered: yes" in ctl("show"))); return 0
    if argv[:1] == ["list"]:
        return cmd_list("--scan" in argv)
    if argv[:1] == ["boot"]:
        if setting_off():
            ctl("power", "off")
        return 0
    if argv[:1] == ["power"] and len(argv) == 2:
        return 0 if "succeeded" in ctl("power", "on" if argv[1] == "on" else "off") else 1
    if len(argv) == 2 and is_mac(argv[1]):
        if argv[0] == "connect":
            return cmd_connect(argv[1])
        if argv[0] == "disconnect":
            return 0 if "Successful" in ctl("disconnect", argv[1]) else 1
        if argv[0] == "forget":
            return 0 if "removed" in ctl("remove", argv[1]) else 1
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
