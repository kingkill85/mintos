#!/usr/bin/python3
"""Audio helper for the RG353V (rk817 codec on mainline).

- Routes output to the speaker, or to the headphones while a plug is in. Mainline
  leaves "Playback Mux" on HP, so the speaker stays silent. The jack state is the ALSA
  card control "Headphones Jack"; changes arrive as SW_HEADPHONE_INSERT events.
- Volume buttons (gpio-keys-vol) change "Master" in 5 % steps of the perceptual scale; holding repeats.
  With F held (BTN_MODE on "RG353V Gamepad") they change the brightness in the 10 steps of
  the settings instead. Every change goes to /run/mintos-osd ("<seq> vol|bright <0..10>"),
  which rglauncher and rgarch show as an overlay (common/osd.c).
- Bluetooth headphones (bluealsa): while one is connected, ALSA's default device points to it
  (/run/mintos/asound-bt.conf, loaded by /etc/asound.conf) and the volume buttons change its
  volume. A game picks the device up when it starts.
"""
import asyncio
import os
import re
import subprocess
import evdev
from evdev import ecodes as e


def amixer(*args):
    return subprocess.run(["amixer", "-c", "rk817int", *args], capture_output=True, text=True).stdout


def route():
    out = "HP" if ": values=on" in amixer("cget", "iface=CARD,name=Headphones Jack") else "SPK"
    amixer("-q", "sset", "Playback Mux", out)
    print("audio ->", out, flush=True)


BT_CONF = "/run/mintos/asound-bt.conf"
bt_current = None   # bluealsa PCM path of the connected headphones


def bt_sink(pcms):
    """the playback PCM (we are the A2DP source) from `bluealsa-cli list-pcms`"""
    return next((p for p in pcms.split() if p.endswith("/a2dpsrc/sink")), None)


def bt_mac(path):
    m = re.search(r"dev_((?:[0-9A-F]{2}_){5}[0-9A-F]{2})", path)
    return m.group(1).replace("_", ":") if m else ""


def bt_conf(mac):
    return 'pcm.!default {\n  type plug\n  slave.pcm "bluealsa:DEV=%s,PROFILE=a2dp"\n}\n' % mac


def bt_volume_parse(out):
    m = re.search(r"Volume:\D*(\d+)", out)
    return int(m.group(1)) if m else None


def step(v, d):
    return max(0, min(127, v + 6 * d))


def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


async def bt_watch():
    global bt_current
    while True:
        sink = bt_sink(run("bluealsa-cli", "list-pcms"))
        if sink != bt_current:
            bt_current = sink
            if sink:
                os.makedirs(os.path.dirname(BT_CONF), exist_ok=True)
                with open(BT_CONF + ".tmp", "w") as f:
                    f.write(bt_conf(bt_mac(sink)))
                os.replace(BT_CONF + ".tmp", BT_CONF)
                print("audio -> bluetooth", bt_mac(sink), flush=True)
            else:
                try:
                    os.unlink(BT_CONF)
                except FileNotFoundError:
                    pass
                print("audio -> device", flush=True)
        await asyncio.sleep(2)


def bt_volume(d):
    v = bt_volume_parse(run("bluealsa-cli", "volume", bt_current))
    if v is not None:
        v = step(v, d)
        run("bluealsa-cli", "volume", bt_current, str(v))
    return v


async def jack(dev):
    async for ev in dev.async_read_loop():
        if ev.type == e.EV_SW and ev.code == e.SW_HEADPHONE_INSERT:
            route()


OSD_FILE = "/run/mintos-osd"
BACKLIGHT = "/sys/class/backlight/backlight"
f_held = False


def osd(kind, value):
    """tell rglauncher/rgarch to show the overlay"""
    import time
    try:
        with open(OSD_FILE + ".tmp", "w") as f:
            f.write("%d %s %d\n" % (time.time_ns(), kind, max(0, min(10, value))))
        os.replace(OSD_FILE + ".tmp", OSD_FILE)
    except OSError:
        pass


def bl_step(raw, mx):
    """as common/settings.c: 10 steps, 1 is the dimmest"""
    if mx <= 0:
        return 10
    return max(1, min(10, (raw * 10 + mx // 2) // mx))


def bl_raw(step, mx):
    return mx * max(1, min(10, step)) // 10


def brightness(d):
    try:
        mx = int(open(BACKLIGHT + "/max_brightness").read())
        cur = bl_step(int(open(BACKLIGHT + "/brightness").read()), mx)
        new = max(1, min(10, cur + d))
        with open(BACKLIGHT + "/brightness", "w") as f:
            f.write("%d\n" % bl_raw(new, mx))
        osd("bright", new)
    except (OSError, ValueError):
        pass


def master_pct(out):
    """first "[NN%]" of a Playback line from amixer"""
    m = re.search(r"Playback.*?\[(\d+)%\]", out)
    return int(m.group(1)) if m else None


async def fkey(dev):
    global f_held
    async for ev in dev.async_read_loop():
        if ev.type == e.EV_KEY and ev.code == e.BTN_MODE:
            f_held = ev.value != 0


async def fkey_find():
    """rg353-pad creates "RG353V Gamepad" (uinput); it may come up after us"""
    while True:
        pad = next((evdev.InputDevice(p) for p in evdev.list_devices()
                    if evdev.InputDevice(p).name == "RG353V Gamepad"), None)
        if pad:
            try:
                await fkey(pad)
            except OSError:   # rg353-pad restarted
                pass
        await asyncio.sleep(1)


async def volume(dev):
    async for ev in dev.async_read_loop():
        if ev.type == e.EV_KEY and ev.value in (1, 2):  # press or autorepeat
            d = 1 if ev.code == e.KEY_VOLUMEUP else -1 if ev.code == e.KEY_VOLUMEDOWN else 0
            if d and f_held:
                brightness(d)
            elif d and bt_current:
                v = bt_volume(d)
                if v is not None:
                    osd("vol", (v * 10 + 63) // 127)
            elif d:
                # -M: perceptual scale (as alsamixer); the raw one is linear in dB from
                # -95 to 0 dB, so its 50 % (-47 dB) sounded like 10 %
                v = master_pct(amixer("-M", "sset", "Master", "5%+" if d > 0 else "5%-"))
                if v is not None:
                    osd("vol", (v + 5) // 10)


async def main():
    devs = {evdev.InputDevice(p).name: evdev.InputDevice(p) for p in evdev.list_devices()}
    route()
    tasks = [jack(d) for n, d in devs.items() if n.endswith("Headphones")]
    tasks += [volume(d) for n, d in devs.items() if n == "gpio-keys-vol"]
    tasks.append(fkey_find())
    tasks.append(bt_watch())
    await asyncio.gather(*tasks)


if __name__ == "__main__":
    asyncio.run(main())
