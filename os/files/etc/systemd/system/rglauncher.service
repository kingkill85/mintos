[Unit]
Description=rglauncher game list
After=systemd-user-sessions.service sound.target
StartLimitIntervalSec=0
Conflicts=getty@tty1.service

[Service]
Environment=HOME=/storage SDL_VIDEODRIVER=kmsdrm
WorkingDirectory=/storage
ExecStart=/storage/.config/rglauncher/rglauncher
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
# the boot logo stays in the console framebuffer; blank it once the list is up
ExecStartPost=/bin/sh -c 'sleep 2; cat /dev/zero > /dev/fb0 2>/dev/null; true'
Restart=always
RestartSec=0

[Install]
WantedBy=multi-user.target
