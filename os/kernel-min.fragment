# Minimal RG353V kernel on top of localyesconfig: only Rockchip, no initramfs.
# Wi-Fi/Bluetooth stay modules: their firmware lives on the rootfs.
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BCM2835=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_K3=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_MEDIATEK=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_NXP=n
CONFIG_ARCH_LAYERSCAPE=n
CONFIG_ARCH_MXC=n
CONFIG_ARCH_QCOM=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_SYNQUACER=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_THUNDER=n
CONFIG_ARCH_THUNDER2=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_XGENE=n
CONFIG_ARCH_ZYNQMP=n
CONFIG_ARCH_ROCKCHIP=y
CONFIG_PCI=n
CONFIG_ACPI=n
CONFIG_EFI=n
CONFIG_VIRTUALIZATION=n
CONFIG_KVM=n
CONFIG_XEN=n
CONFIG_HIBERNATION=n
CONFIG_NUMA=n
CONFIG_SECURITY_SELINUX=n
CONFIG_SECURITY_APPARMOR=n
CONFIG_SECURITY_TOMOYO=n
CONFIG_SECURITY_LOCKDOWN_LSM=n
CONFIG_IMA=n
CONFIG_EVM=n
CONFIG_BLK_DEV_INITRD=n
CONFIG_MODULE_COMPRESS=n
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RTW88=m
CONFIG_RTW88_8821CS=m
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_RTL=y
CONFIG_BT_HCIUART_3WIRE=y
CONFIG_BT_RTL=m
CONFIG_RFKILL=m
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_INPUT_UINPUT=y
# Touchscreen (Hynitron CST340 on i2c) - not enabled in Debian's config
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_HYNITRON_CSTXXX=y
# no tracing/probing/BPF, no video decoder hardware, no firewall/MPTCP/io_uring/IPv6
CONFIG_FTRACE=n
CONFIG_KPROBES=n
CONFIG_UPROBES=n
CONFIG_BPF_SYSCALL=n
CONFIG_PROFILING=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_NETFILTER=n
CONFIG_MPTCP=n
CONFIG_IO_URING=n
CONFIG_IPV6=n
CONFIG_AUDIT=n
# analog sticks: adc-joystick reads 4 axes through an ADC multiplexer (missing in Debian's config)
CONFIG_MULTIPLEXER=y
CONFIG_MUX_GPIO=y
CONFIG_IIO_MUX=y
# Bluetooth controllers: classic HID (BT_HIDP) and BLE HID over GATT (bluez needs /dev/uhid)
CONFIG_BT_HIDP=m
CONFIG_UHID=m
CONFIG_HID_MICROSOFT=m
